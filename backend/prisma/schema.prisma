generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(EMPLOYEE)
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  EMPLOYEE
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
}

model Product {
  id        Int             @id @default(autoincrement())
  name      String
  type      ProductType
  category  ProductCategory
  active    Boolean         @default(true)
  prices    ProductPrice[]
  createdAt DateTime        @default(now())
  deleted   Boolean         @default(false)
}

model ProductPrice {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  price     Decimal  @db.Decimal(10, 2)
  validFrom DateTime @default(now())
  createdAt DateTime @default(now())
}

enum ProductType {
  STANDARD
  SPECIAL
}

enum ProductCategory {
  BACKWARE
  SUESSWARE
}

model Employee {
  id        Int            @id @default(autoincrement())
  name      String
  role      String?
  avatar    String?
  phone     String?
  email     String?
  createdAt DateTime       @default(now())
  files     EmployeeFile[]
}

model EmployeeFile {
  id         Int      @id @default(autoincrement())
  employeeId Int
  name       String
  path       String
  uploadedAt DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id])
}
